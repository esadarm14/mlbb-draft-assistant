{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/((?!api/).*)", "destination": "/public/$1" }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "data/**",
      "maxDuration": 15
    },
    "api/*.mjs": {
      "includeFiles": "data/**",
      "maxDuration": 15
    }
  }
}
