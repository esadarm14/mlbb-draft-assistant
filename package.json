{
  "name": "mlbb-draft-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "MLBB Draft Assistant with Moonton-first public data monitoring and human-reviewed updates",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "server": "node src/server.mjs",
    "build:apk": "eas build -p android --profile preview",
    "ci:proposal": "node scripts/ci-proposal.mjs",
    "validate": "node src/validate-data.mjs",
    "test": "node --experimental-strip-types --test",
    "ios": "expo run:ios"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@types/react": "~18.3.12",
    "expo": "~52.0.49",
    "expo-asset": "~11.0.4",
    "expo-status-bar": "~2.0.1",
    "playwright": "^1.56.1",
    "react": "^18.3.1",
    "react-native": "^0.76.6",
    "react-native-safe-area-context": "^4.12.0",
    "typescript": "~5.3.3"
  }
}
